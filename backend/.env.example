SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...          # Settings → API → Legacy anon key
SUPABASE_SERVICE_KEY=eyJ...       # Settings → API → Legacy service_role key
# Token signature verification keys. Supabase's current default signs user JWTs
# with ES256 — set SUPABASE_JWT_PUBLIC_KEY (the project's public key PEM, from
# Settings → JWT Keys) or those tokens will be rejected. SUPABASE_JWT_SECRET is
# only needed for projects still on the legacy HS256 signing key.
SUPABASE_JWT_SECRET=your-jwt-secret  # Settings → JWT Keys → JWT Secret (legacy HS256)
SUPABASE_JWT_PUBLIC_KEY=            # -----BEGIN PUBLIC KEY----- ... (ES256, current default)
OPENAI_API_KEY=sk-...
# Model routing — the default (set in app/core/config.py) is gpt-5.6-luna for
# every lane (heavy + light + OCR; luna is confirmed multimodal, ~10% of
# terra's cost). Uncomment to override — e.g. restore terra on the heavy lane
# if generation quality needs a lift (2026-07 canary: terra 17/20, luna 14/20).
# The API key only has access to gpt-5.6-terra, gpt-5.6-luna, gpt-5.4-nano and
# gpt-5.4-nano-2026-03-17 — gpt-4o / gpt-4o-mini were revoked (2026-07).
# GENERATION_MODEL=gpt-5.6-terra
# GENERATION_LIGHT_MODEL=gpt-5.6-luna
# The Topic Plan (root artifact) runs terra by default — highest leverage per
# token in the pipeline. Blocking-gate failures on any lane rerun once on the
# escalation model. Empty PLAN pin = follow GENERATION_MODEL; empty ESCALATION
# disables reruns.
# GENERATION_PLAN_MODEL=gpt-5.6-terra
# GENERATION_ESCALATION_MODEL=gpt-5.6-terra
FRONTEND_URL=http://localhost:5173
# Hardcoded demo personas (incl. superadmin). Defaults to false (secure). Set
# true ONLY for local/demo environments — never in a real deployment.
DEMO_LOGIN_ENABLED=false
