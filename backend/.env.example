SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...          # Settings → API → Legacy anon key
SUPABASE_SERVICE_KEY=eyJ...       # Settings → API → Legacy service_role key
SUPABASE_JWT_SECRET=your-jwt-secret  # Settings → JWT Keys → JWT Secret
OPENAI_API_KEY=sk-...
# Model routing — defaults (set in app/core/config.py) are already the GPT-5.6
# stack: terra (heavy) / 5.4-nano (light) / luna (OCR). Uncomment to override.
# The API key only has access to gpt-5.6-terra, gpt-5.6-luna, gpt-5.4-nano and
# gpt-5.4-nano-2026-03-17 — gpt-4o / gpt-4o-mini were revoked (2026-07).
# OCR_MODEL pins vision transcription to a confirmed-multimodal tier — keep it
# set while GENERATION_LIGHT_MODEL points at a tier with unverified vision.
# GENERATION_MODEL=gpt-5.6-terra
# GENERATION_LIGHT_MODEL=gpt-5.4-nano
# OCR_MODEL=gpt-5.6-luna
FRONTEND_URL=http://localhost:5173
# Hardcoded demo personas (incl. superadmin). Keep true only for local/demo
# environments — set to false in any real deployment.
DEMO_LOGIN_ENABLED=true
